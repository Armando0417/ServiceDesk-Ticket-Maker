{
    "manifest_version": 3,
    "name": "Ticket Autofill Alt - Automatic",
    "version": "3.6.2026.731",
    "version_name": "3.6.2026.731",
    "description": "Automatically fills ManageEngine ServiceDesk fields from clipboard JSON, with focus-based fallback.",
    "content_scripts": [
        {
            "matches": [
                "https://servicedesk.mmmhc.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "clipboardRead"
    ]
}
