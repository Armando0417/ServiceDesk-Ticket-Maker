{
    "manifest_version": 3,
    "name": "Ticket Autofill",
    "version": "1.0",
    "description": "Auto-fills ManageEngine ServiceDesk fields from clipboard JSON. Tab/click into fields to fill them.",
    "content_scripts": [
        {
            "matches": [
                "https://servicedesk.mmmhc.com/*"
            ],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "clipboardRead"
    ],
    "icons": {
        "48": "icon.png"
    }
}
